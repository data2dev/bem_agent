# Copy to .env for local experiments. Never commit .env.
# On Cloud Run these come from Secret Manager instead.

# Which LLM drives the agent: groq (default) | anthropic | openai | gemini | openai_compatible
BEM_LLM_PROVIDER=groq
# Optional: override the provider's default model
# BEM_LLM_MODEL=openai/gpt-oss-120b
# BEM_LLM_MODEL=llama-3.3-70b-versatile
# BEM_LLM_MODEL=claude-opus-5-5

GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# For openai_compatible (OpenRouter, vLLM, Ollama, ...)
# BEM_LLM_BASE_URL=
# BEM_LLM_API_KEY=

# Path to an EnergyPlus install (contains the energyplus executable)
# ENERGYPLUS_DIR=
